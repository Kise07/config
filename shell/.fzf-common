# ----------------------------
# FZF loader (portable)
# ----------------------------

if [ -f "$HOME/.fzf.bash" ]; then
  source "$HOME/.fzf.bash"
fi

if [ -f "$HOME/.fzf.zsh" ]; then
  source "$HOME/.fzf.zsh"
fi

# fzf-git (optional)
if [ -f "$HOME/fzf-git.sh/fzf-git.sh" ]; then
  source "$HOME/fzf-git.sh/fzf-git.sh"
fi

