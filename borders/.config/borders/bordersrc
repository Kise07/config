#!/bin/sh
# ── JankyBorders ─────────────────────────────────────────────────────
# Executed automatically by the borders service when launched with no args
# (see: man borders — "we try to execute a file at ~/.config/borders/bordersrc").
# Started via: brew services start borders
#
# Deliberately no arrays / no $'…' escapes — this must work under /bin/sh,
# which is no longer bash on macOS.

# ── Colours ──────────────────────────────────────────────────────────
# ONE source of truth, shared with the bar: ~/.config/sketchybar/colors.sh
# Edit that file (uncomment a scheme block), then reload bar + border:
#     sketchybar --reload
#     pkill -x borders && /opt/homebrew/bin/borders &
#
# Josean-style flat exports. borders consumes two of them:
#   ACCENT_COLOR        focused window border   (Catppuccin Mocha mauve)
#   BORDER_INACTIVE     unfocused windows       (Catppuccin Mocha surface1)
. "${HOME}/.config/sketchybar/colors.sh"

# style=round           rounded corners, matching SketchyBar's corner_radius
# width=6.0             border thickness in points
# hidpi=on              retina rendering
#
# ax_focus is intentionally NOT set here. It must be left out because borders
# has no Accessibility permission yet — forcing ax_focus=on makes borders exit
# immediately ("must be trusted with accessibility permissions"). Per man
# borders, ax_focus is *enabled automatically* once the process is trusted, so
# it turns itself on after you add borders in
# System Settings → Privacy & Security → Accessibility.

borders style=round \
        width=6.0 \
        hidpi=on \
        active_color="${ACCENT_COLOR}" \
        inactive_color="${BORDER_INACTIVE}"
